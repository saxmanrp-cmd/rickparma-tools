{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rick-fuel-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
