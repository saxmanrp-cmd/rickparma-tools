<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Song Request App — Setup Wizard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@600;700&family=Lato:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#130101;
    --card-solid:#1c0808;
    --accent:#8DB2E5;
    --white:#F5F3F0;
    --dim:#C9C2BC;
    --line:rgba(245,243,240,0.12);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{background:var(--bg); color:var(--white); font-family:'Lato',sans-serif;}
  body{max-width:620px; margin:0 auto; padding:30px 20px 80px;}
  h1{font-family:'Josefin Sans',sans-serif; font-size:26px; margin-bottom:6px;}
  .eyebrow{font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--accent); font-weight:700; margin-bottom:8px;}
  .intro{color:var(--dim); font-size:14px; line-height:1.6; margin-bottom:28px;}
  .section{margin-bottom:26px; padding-bottom:26px; border-bottom:1px solid var(--line);}
  .section:last-of-type{border-bottom:none;}
  .section-title{font-family:'Josefin Sans',sans-serif; font-size:16px; margin-bottom:14px; color:var(--white);}
  label{display:block; font-size:12px; color:var(--dim); margin-bottom:5px; margin-top:14px; font-weight:700;}
  label:first-of-type{margin-top:0;}
  input{width:100%; padding:11px 13px; font-size:16px; border-radius:9px; border:1px solid var(--line); background:var(--card-solid); color:var(--white); font-family:'Lato',sans-serif;}
  input::placeholder{color:#6b625b;}
  .hint{font-size:11.5px; color:#8a8078; margin-top:4px; line-height:1.4;}
  .price-row{display:flex; gap:12px;}
  .price-row > div{flex:1;}
  .btn{display:block; width:100%; padding:16px; border-radius:12px; font-size:16px; font-weight:700; font-family:'Lato',sans-serif; border:none; cursor:pointer; margin-top:10px;}
  .btn-primary{background:var(--accent); color:#0c1420;}
  .btn-primary:disabled{opacity:0.4;}
  .status{margin-top:16px; font-size:13px; color:var(--dim); line-height:1.6;}
  .status.success{color:#8DB2E5;}
  .status.error{color:#E86B6B;}
  a{color:var(--accent);}
  .steps{font-size:13px; color:var(--dim); line-height:1.8; margin-top:16px; padding:14px; background:var(--card-solid); border-radius:10px; border:1px solid var(--line);}
  .steps b{color:var(--white);}
</style>
</head>
<body>

<div class="eyebrow">Setup Wizard — Demo</div>
<h1>Generate Your Song Request App</h1>
<p class="intro">Fill this out once, download two files, upload them to your own free hosting (GitHub Pages, Netlify, etc.), and you'll have your own version of this tool — same features, your info baked in.</p>

<div class="section">
  <div class="section-title">Your Info</div>
  <label>Artist / Business Name</label>
  <input type="text" id="artistName" placeholder="e.g. Jamie Rivera">

  <label>Contact Phone Number (requests get texted here)</label>
  <input type="text" id="contactNumber" placeholder="e.g. 5551234567">
  <div class="hint">Digits only, no dashes or spaces.</div>

  <label>Apple Cash Number (optional — leave blank to reuse the number above)</label>
  <input type="text" id="appleCashNumber" placeholder="e.g. 555-123-4567">
</div>

<div class="section">
  <div class="section-title">Payment Links</div>
  <label>Venmo Username</label>
  <input type="text" id="venmoUsername" placeholder="e.g. JamieRivera">

  <label>Cash App $Cashtag (without the $)</label>
  <input type="text" id="cashappTag" placeholder="e.g. JamieRivera">

  <label>PayPal.me Username</label>
  <input type="text" id="paypalUsername" placeholder="e.g. jamierivera">
</div>

<div class="section">
  <div class="section-title">Pricing</div>
  <div class="price-row">
    <div>
      <label>General Price ($)</label>
      <input type="number" id="generalPrice" value="5">
    </div>
    <div>
      <label>Special Price ($)</label>
      <input type="number" id="specialPrice" value="20">
    </div>
  </div>
</div>

<div class="section">
  <div class="section-title">Cloud Storage</div>
  <label>JSONbin Master API Key</label>
  <input type="text" id="masterKey" placeholder="Paste your JSONbin master key">
  <div class="hint">Free account at <a href="https://jsonbin.io" target="_blank">jsonbin.io</a> — this key lets your app read/write your own song list. Don't use anyone else's key.</div>
</div>

<button class="btn btn-primary" id="generateBtn" onclick="generateFiles()">Generate My Files</button>
<div class="status" id="statusMsg"></div>

<div class="steps">
  <b>After downloading:</b><br>
  1. Upload both files to a free static host (GitHub Pages, Netlify, Cloudflare Pages)<br>
  2. Open your song-manager.html on your phone → tap "Create Cloud Storage"<br>
  3. Copy the Bin ID it gives you into the <code>BIN_ID</code> line near the top of <b>both</b> files, then re-upload both<br>
  4. Add your songs in the manager, and you're live
</div>

<script>
const REQUEST_TEMPLATE_B64 = "";
const MANAGER_TEMPLATE_B64 = "";

function decodeB64Utf8(b64){
  const binary = atob(b64);
  const bytes = new Uint8Array(binary.length);
  for(let i = 0; i < binary.length; i++){
    bytes[i] = binary.charCodeAt(i);
  }
  return new TextDecoder('utf-8').decode(bytes);
}

function slugify(str){
  return (str || 'artist').toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'artist';
}

function fillTemplate(template, values){
  let out = template;
  for(const key in values){
    out = out.split('{{' + key + '}}').join(values[key]);
  }
  return out;
}

function downloadFile(filename, content){
  const blob = new Blob([content], { type: 'text/html;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function generateFiles(){
  const statusEl = document.getElementById('statusMsg');
  statusEl.className = 'status';

  const artistName = document.getElementById('artistName').value.trim();
  const contactNumber = document.getElementById('contactNumber').value.replace(/\D/g, '');
  let appleCashNumber = document.getElementById('appleCashNumber').value.trim();
  const venmoUsername = document.getElementById('venmoUsername').value.trim();
  const cashappTag = document.getElementById('cashappTag').value.trim().replace(/^\$/, '');
  const paypalUsername = document.getElementById('paypalUsername').value.trim();
  const generalPrice = parseFloat(document.getElementById('generalPrice').value) || 5;
  const specialPrice = parseFloat(document.getElementById('specialPrice').value) || 20;
  const masterKey = document.getElementById('masterKey').value.trim();

  if(!artistName || !contactNumber || !venmoUsername || !cashappTag || !paypalUsername || !masterKey){
    statusEl.textContent = 'Please fill in all required fields (Apple Cash number is optional).';
    statusEl.className = 'status error';
    return;
  }

  if(!appleCashNumber) appleCashNumber = contactNumber;

  const slug = slugify(artistName);
  const values = {
    ARTIST_NAME: artistName,
    ARTIST_SLUG: slug,
    CONTACT_NUMBER: contactNumber,
    APPLE_CASH_NUMBER: appleCashNumber,
    VENMO_USERNAME: venmoUsername,
    CASHAPP_TAG: cashappTag,
    PAYPAL_USERNAME: paypalUsername,
    GENERAL_PRICE: generalPrice,
    SPECIAL_PRICE: specialPrice,
    MASTER_KEY: masterKey
  };

  try{
    const requestTemplate = decodeB64Utf8(REQUEST_TEMPLATE_B64);
    const managerTemplate = decodeB64Utf8(MANAGER_TEMPLATE_B64);

    const requestFile = fillTemplate(requestTemplate, values);
    const managerFile = fillTemplate(managerTemplate, values);

    downloadFile('song-request.html', requestFile);
    setTimeout(() => downloadFile('song-manager.html', managerFile), 300);

    statusEl.textContent = 'Done! Two files downloaded — follow the steps below to get them live.';
    statusEl.className = 'status success';
  } catch(err){
    console.error(err);
    statusEl.textContent = 'Something went wrong generating the files. Check the browser console for details.';
    statusEl.className = 'status error';
  }
}
</script>
</body>
</html>
