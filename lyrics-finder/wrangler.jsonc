{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rick-lyrics-finder",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
