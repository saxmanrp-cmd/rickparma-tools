{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "social-publisher-v3",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "META_GRAPH_VERSION": "v24.0"
  },
  "services": [
    {
      "binding": "SMS_BLAST",
      "service": "sms-blast"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-publisher-db",
      "database_id": "6f10727b-1db1-4dc0-8431-32dc93b91cd4"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "social-publisher-media" }
  ],
  "observability": { "enabled": true }
}
