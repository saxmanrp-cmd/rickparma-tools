# Local Worker development only. Never commit real values.
APP_PASSWORD=choose-a-private-password
SESSION_SECRET=replace-with-random-value
TOKEN_ENCRYPTION_KEY=replace-with-random-value
META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-meta-app-secret
APP_BASE_URL=https://your-deployed-worker.workers.dev
# Optional if Meta gives you a Facebook Login for Business configuration ID:
# META_LOGIN_CONFIG_ID=replace-me

# TikTok Login Kit + Content Posting API (draft upload)
TIKTOK_CLIENT_KEY=replace-with-tiktok-client-key
TIKTOK_CLIENT_SECRET=replace-with-tiktok-client-secret

# Threads API
THREADS_APP_ID=replace-with-threads-app-id
THREADS_APP_SECRET=replace-with-threads-app-secret
